+func TestKeycapsRealBrowserPhases(t *testing.T) {
+	v := keycapsBrowser(t)
+	if err := ExecuteCaptionOn(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	steps := []struct {
+		key  input.Key
+		down bool
+		want string
+	}{
+		{input.ControlLeft, true, "Ctrl ↓"},
+		{input.Digit1, true, "Ctrl ↓|1 ↓"},
+		{input.Digit1, false, "Ctrl ↓|1 ↓|1 ↑"},
+		{input.ControlLeft, false, "Ctrl ↓|1 ↓|1 ↑|Ctrl ↑"},
+	}
+	for _, step := range steps {
+		var err error
+		if step.down {
+			err = v.Page.Keyboard.Press(step.key)
+		} else {
+			err = v.Page.Keyboard.Release(step.key)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := capsText(t, v); got != step.want {
+			t.Fatalf("physical phase: got %q, want %q", got, step.want)
+		}
+		if step.key == input.Digit1 {
+			r, err := v.Page.Eval(`() => document.querySelectorAll('.vhs-keycap[data-held="true"]').length`)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := 1
+			if step.down {
+				want = 2
+			}
+			if got := r.Value.Int(); got != want {
+				t.Fatalf("held keys: got %d, want %d", got, want)
+			}
+		}
+	}
+	if err := v.Page.Wait(rod.Eval(`() => document.querySelector('.vhs-keycaps').childElementCount === 0`)); err != nil {
+		t.Fatal(err)
+	}
+}
