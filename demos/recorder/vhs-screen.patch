+package main
+
+import (
+	_ "embed"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/go-rod/rod/lib/input"
+)
+
+//go:embed keycaps.js
+var keycapsScript string
+
+func (v *VHS) syncKeycaps() error {
+	if !v.Options.Video.Keycaps {
+		return nil
+	}
+	if !v.Options.Video.CompositeFrames {
+		return errors.New("VHS_KEYCAPS requires VHS_SCREEN_CAPTURE=true")
+	}
+	_, err := v.Page.Eval(keycapsScript, v.keycapsEnabled, v.recording, v.Options.Caption)
+	if err != nil {
+		return fmt.Errorf("update browser keycaps: %w", err)
+	}
+	return nil
+}
+
+// Delay physical actions so captured frames can show keys while they are held.
+// The overlay observes the browser; this path never supplies caption events.
+func (v *VHS) sendKeycapsChord(keys []input.Key) (retErr error) {
+	var held []input.Key
+	defer func() {
+		for i := len(held) - 1; i >= 0; i-- {
+			if err := v.Page.Keyboard.Release(held[i]); err != nil {
+				retErr = errors.Join(retErr, fmt.Errorf("release chord key: %w", err))
+			}
+		}
+	}()
+	for _, key := range keys {
+		if err := v.Page.Keyboard.Press(key); err != nil {
+			return fmt.Errorf("press chord key: %w", err)
+		}
+		held = append(held, key)
+		if err := v.waitKeycapsPhase(); err != nil {
+			return err
+		}
+	}
+	for len(held) > 0 {
+		last := len(held) - 1
+		if err := v.Page.Keyboard.Release(held[last]); err != nil {
+			return fmt.Errorf("release chord key: %w", err)
+		}
+		held = held[:last]
+		if err := v.waitKeycapsPhase(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (v *VHS) waitKeycapsPhase() error {
+	timer := time.NewTimer(v.Options.TypingSpeed)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-v.Page.GetContext().Done():
+		return fmt.Errorf("wait for chord phase: %w", v.Page.GetContext().Err())
+	}
+}
