+func TestKeycapsFailures(t *testing.T) {
+	v := keycapsBrowser(t)
+	v.Options.Video.CompositeFrames = false
+	if err := ExecuteCaptionOn(parser.Command{}, v); err == nil {
+		t.Fatal("accepted keycaps without composite capture")
+	}
+	v.Options.Video.CompositeFrames = true
+	if _, err := v.Page.Eval(`() => document.querySelector('.xterm-screen').remove()`); err != nil {
+		t.Fatal(err)
+	}
+	if err := ExecuteCaptionOn(parser.Command{}, v); err == nil {
+		t.Fatal("accepted keycaps without terminal screen")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	v.Page = v.Page.Context(ctx)
+	if err := v.waitKeycapsPhase(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("phase wait ignored cancellation: %v", err)
+	}
+	if err := v.sendKeycapsChord([]input.Key{input.ControlLeft}); err == nil {
+		t.Fatal("accepted input on canceled page")
+	}
+	if err := v.Page.Context(context.Background()).Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.sendKeycapsChord([]input.Key{input.ControlLeft}); err == nil {
+		t.Fatal("accepted input on closed page")
+	}
+	v.Options.Video.Keycaps = false
+	if err := v.syncKeycaps(); err != nil {
+		t.Fatalf("inactive keycaps touched browser: %v", err)
+	}
+}
