+func TestKeycapsVisibilityAndInput(t *testing.T) {
+	v := keycapsBrowser(t)
+	v.Options.Caption.MaxKeysOnscreen = 4
+	v.Options.Caption.InactivityTimerMs = 1000
+	if err := ExecuteCaptionOn(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	if err := ExecuteCtrl(parser.Command{Args: "1"}, v); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "Ctrl ↓|1 ↓|1 ↑|Ctrl ↑" {
+		t.Fatalf("recorded chord phases: %q", got)
+	}
+	screen, err := v.Page.Element(".xterm-screen")
+	if err != nil {
+		t.Fatal(err)
+	}
+	frame, err := screen.Screenshot(proto.PageCaptureScreenshotFormatPng, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	img, _, err := image.Decode(bytes.NewReader(frame))
+	if err != nil || img.Bounds().Dx() != 600 || img.Bounds().Dy() != 250 {
+		t.Fatalf("native screen capture: %v", err)
+	}
+	if err := ExecuteHide(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Page.Keyboard.Type(input.KeyA); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "" {
+		t.Fatalf("hidden input displayed: %q", got)
+	}
+	if err := ExecuteShow(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Page.Keyboard.Type(input.KeyB); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "b ↓|b ↑" {
+		t.Fatalf("resumed input phases: %q", got)
+	}
+	if _, err := v.Page.Eval(`() => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'x', code: 'KeyX' }))`); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "b ↓|b ↑" {
+		t.Fatalf("untrusted event displayed: %q", got)
+	}
+	if err := ExecuteCaptionOff(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Page.Keyboard.Type(input.KeyC); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "" {
+		t.Fatalf("disabled input displayed: %q", got)
+	}
+	r, err := v.Page.Eval(`() => document.querySelector('textarea').value`)
+	if err != nil || r.Value.Str() != "abc" {
+		t.Fatalf("native input was intercepted: %v", err)
+	}
+	if err := ExecuteCaptionOn(parser.Command{}, v); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Page.Keyboard.Type(input.KeyD); err != nil {
+		t.Fatal(err)
+	}
+	if got := capsText(t, v); got != "d ↓|d ↑" {
+		t.Fatalf("duplicate or stale listeners: %q", got)
+	}
+}
