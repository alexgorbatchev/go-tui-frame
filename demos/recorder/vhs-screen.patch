+	t.Setenv("VHS_KEYCAPS", "true")
+	t.Setenv("VHS_SCREEN_CAPTURE", "true")
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		if _, err := w.Write([]byte(`<div class="xterm-screen" style="position:relative;width:600px;height:250px"><textarea autofocus></textarea></div>`)); err != nil {
+			t.Error(err)
+		}
+	}))
+	t.Cleanup(server.Close)
+	path, found := launcher.LookPath()
+	if !found {
+		t.Fatal("installed Chromium browser required")
+	}
+	l := launcher.New().Bin(path).UserDataDir(t.TempDir()).Leakless(false)
+	u, err := l.Launch()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(l.Cleanup)
+	b := rod.New().ControlURL(u)
+	if err := b.Connect(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := b.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	p, err := b.Page(proto.TargetCreateTarget{URL: server.URL})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p = p.Timeout(5 * time.Second)
+	if err := p.WaitLoad(); err != nil {
+		t.Fatal(err)
+	}
+	textarea, err := p.Element("textarea")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := textarea.Focus(); err != nil {
+		t.Fatal(err)
+	}
+	v := New()
+	v.Page = p
+	v.Options.Caption.InactivityTimerMs = 80
+	v.Options.TypingSpeed = 10 * time.Millisecond
+	v.ResumeRecording()
+	return &v
+}
+
+func capsText(t *testing.T, v *VHS) string {
+	t.Helper()
+	r, err := v.Page.Eval(`() => [...document.querySelectorAll('.vhs-keycap')].map(e => e.textContent).join('|')`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r.Value.Str()
+}
