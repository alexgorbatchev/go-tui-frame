+(enabled, visible, opts) => {
+  if (!window.vhsKeycaps) {
+    const screen = document.querySelector('.xterm-screen');
+    if (!screen) throw new Error('keycaps require a terminal screen');
+    const host = document.createElement('div');
+    host.className = 'vhs-keycaps';
+    Object.assign(host.style, {
+      position: 'absolute', zIndex: '100', pointerEvents: 'none',
+      right: `${opts.MarginRight}px`, bottom: `${opts.MarginVertical}px`,
+      display: 'flex', gap: '6px', maxWidth: '100%',
+      fontFamily: opts.Font, fontSize: `${opts.FontSize}px`,
+      fontWeight: '700', lineHeight: '1.2', letterSpacing: 'normal',
+    });
+    screen.appendChild(host);
+    const held = new Set();
+    let events = [];
+    let timer;
+    const state = { enabled: false, visible: false };
+    const clear = () => {
+      clearTimeout(timer);
+      held.clear();
+      events = [];
+      host.replaceChildren();
+    };
+    const label = key => ({
+      Control: 'Ctrl', Meta: '⌘', Alt: '⌥', Shift: '⇧',
+      ' ': 'Space', ArrowLeft: '←', ArrowRight: '→',
+      ArrowUp: '↑', ArrowDown: '↓',
+    })[key] || key;
+    const draw = () => {
+      host.replaceChildren(...events.map(event => {
+        const cap = document.createElement('span');
+        const down = event.type === 'keydown';
+        const active = down && held.has(event.code);
+        cap.className = 'vhs-keycap';
+        cap.dataset.held = String(active);
+        cap.dataset.phase = down ? 'down' : 'up';
+        cap.textContent = `${label(event.key)} ${down ? '↓' : '↑'}`;
+        Object.assign(cap.style, {
+          padding: '4px 8px', borderRadius: '5px', whiteSpace: 'nowrap',
+          border: `1px solid ${active ? opts.HighlightColor : '#64748B'}`,
+          color: active ? '#0F172A' : opts.FontColor,
+          backgroundColor: active ? opts.HighlightColor : opts.BoxColor,
+          opacity: active ? '1' : '0.7',
+        });
+        return cap;
+      }));
+    };
+    const observe = event => {
+      if (!state.enabled || !state.visible || !event.isTrusted) return;
+      clearTimeout(timer);
+      if (event.type === 'keydown') held.add(event.code);
+      else held.delete(event.code);
+      events.push({ key: event.key, code: event.code, type: event.type });
+      events = events.slice(-Math.max(1, opts.MaxKeysOnscreen));
+      draw();
+      if (held.size === 0) timer = setTimeout(clear, opts.InactivityTimerMs);
+    };
+    window.addEventListener('keydown', observe, true);
+    window.addEventListener('keyup', observe, true);
+    window.addEventListener('blur', clear);
+    window.vhsKeycaps = {
+      set: (enabled, visible) => {
+        state.enabled = enabled;
+        state.visible = visible;
+        if (!enabled || !visible) clear();
+      },
+    };
+  }
+  window.vhsKeycaps.set(enabled, visible);
+}
