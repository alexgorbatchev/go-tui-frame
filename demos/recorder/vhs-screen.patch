+package main
+
+import (
+	"bytes"
+	"fmt"
+	"image"
+	gifcodec "image/gif"
+	_ "image/png"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestCompositeFrameLoopOffset(t *testing.T) {
+	dir := t.TempDir()
+	frame, err := os.ReadFile("examples/demo.png")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 1; i <= 2; i++ {
+		if err := os.WriteFile(filepath.Join(dir, fmt.Sprintf(textFrameFormat, i)), frame, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	v := VHS{totalFrames: 2, Options: &Options{
+		LoopOffset: 50,
+		Video:      VideoOptions{Input: dir, StartingFrame: 1, CompositeFrames: true},
+	}}
+	if err := v.ApplyLoopOffset(); err != nil {
+		t.Fatal(err)
+	}
+	for _, i := range []int{2, 3} {
+		actual, err := os.ReadFile(filepath.Join(dir, fmt.Sprintf(textFrameFormat, i)))
+		if err != nil || !bytes.Equal(actual, frame) {
+			t.Fatalf("frame %d after rotation: %v", i, err)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(dir, fmt.Sprintf(textFrameFormat, 1))); !os.IsNotExist(err) {
+		t.Fatalf("old frame after rotation: %v", err)
+	}
+}
+
+func TestCompositeFrameEncoding(t *testing.T) {
+	frame, err := os.ReadFile("examples/demo.png")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, format := range []string{"gif", "png"} {
+		t.Run(format, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.WriteFile(filepath.Join(dir, "frame-text-00001.png"), frame, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			style := DefaultStyleOptions()
+			style.Width, style.Height, style.Padding = 320, 240, 0
+			target := filepath.Join(dir, "composite."+format)
+			var data []byte
+			if format == "gif" {
+				opts := DefaultVideoOptions()
+				opts.Input, opts.Style, opts.Output.GIF = dir, style, target
+				opts.CompositeFrames = true
+				if out, err := MakeGIF(opts).CombinedOutput(); err != nil {
+					t.Fatalf("encode composite GIF: %v\n%s", err, out)
+				}
+			} else {
+				opts := NewScreenshotOptions(dir, style)
+				opts.compositeFrames = true
+				opts.screenshots[target] = 1
+				for _, cmd := range MakeScreenshots(opts) {
+					if out, err := cmd.CombinedOutput(); err != nil {
+						t.Fatalf("encode composite screenshot: %v\n%s", err, out)
+					}
+				}
+			}
+			data, err = os.ReadFile(target)
+			if err != nil {
+				t.Fatal(err)
+			}
+			img, _, err := image.Decode(bytes.NewReader(data))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if img.Bounds().Dx() != 320 || img.Bounds().Dy() != 240 {
+				t.Fatalf("encoded bounds: %v", img.Bounds())
+			}
+			if format == "gif" {
+				animation, err := gifcodec.DecodeAll(bytes.NewReader(data))
+				if err != nil || len(animation.Image) == 0 {
+					t.Fatalf("decode composite GIF: %v", err)
+				}
+			}
+		})
+	}
+}
